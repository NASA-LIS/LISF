# == LDT Main Entry Options ==

LDT running mode:                    "LSM parameter processing" # LDT type of run-mode (top-level option)
Processed LSM parameter filename:  ./lis_input.d01.nc   # Final output file read by LIS-7

LIS number of nests:                   1                # Total number of nests run by LIS
Number of surface model types:         1                # Total number of desired surface model types
Surface model types:                 "LSM"              # Surface models:  LSM | Openwater
Land surface model:                  "Noah.3.6"         # Enter LSM(s) of choice
Routing model:                       "none"             #"HYMAP" 
Lake model:                          "none"             # Enter Lake model(s) of choice
Water fraction cutoff value:          0.5               # Fraction at which gridcell is designated as 'water'

Number of met forcing sources:         1                # Enter number of forcing types
Met forcing sources:                 "PRINCETON"             # Enter 'none' if no forcing selected
Met spatial transform methods:        bilinear              # bilinear | budget-bilinear | neighbor | average
Topographic correction method (met forcing):  "lapse-rate"    # none | lapse-rate

LDT diagnostic file:              ldtlog
Undefined value:                   -9999.0              # Universal undefined value
LDT output directory:               LDTOUT              # If metrics or stats are written out
Number of ensembles per tile:         1                 # The number of ensemble members per tile

#Processor layout
Number of processors along x:         2
Number of processors along y:         2

#LIS domain:
Map projection of the LIS domain:   latlon 
Run domain lower left lat:         -59.875
Run domain lower left lon:        -179.875
Run domain upper right lat:         89.875
Run domain upper right lon:        179.875
Run domain resolution (dx):          0.25
Run domain resolution (dy):          0.25

# == Landcover, Landmask and Soil Texture Parameters ==

#Landcover/Mask Parameter Inputs #
Landcover data source:        "MODIS_Native"
Landcover classification:       "IGBPNCEP"              # Enter land cover classification type
Landcover file:                 input/LS_PARAMETERS/lc_parms/MODIS/igbp.bin   # Landcover map path
Landcover spatial transform:      tile                  # none | mode | neighbor | tile
Landcover map projection:        latlon
Landcover fill option:            neighbor              # none | neighbor (Not needed if creating landmask)
Landcover fill radius:             3.                   # Number of pixels to search for neighbor
Landcover fill value:              5.                   # Static value to fill where missing

Create or readin landmask:     "readin" 
Landmask data source:           "MODIS_Native"          # If 'created', recommended to put Landcover source name here
Landmask file:                  input/LS_PARAMETERS/clsmf25_parms/GLDAS-2_0.25-deg/GLDAS-2-mask_0.25_Catch-IGBPNCEP.1gd4r
Landmask spatial transform:     none
Landmask map projection:        latlon
Landmask lower left lat:       -59.875
Landmask lower left lon:     -179.875
Landmask upper right lat:      89.875
Landmask upper right lon:     179.875
Landmask resolution (dx):       0.25
Landmask resolution (dy):       0.25

#Soil texture map:
Soil texture data source:    STATSGOFAO_Native
Soil texture map:            input/LS_PARAMETERS/soil_parms/STATSGOFAO/topsoil30snew
Soil texture spatial transform:   mode                  # none | mode | neighbor | tile
Soil texture fill option:       neighbor                # none | neighbor
Soil texture fill radius:         5                     # Number of pixels to search for neighbor
Soil texture fill value:          6                     # Static value to fill where missing
Soil texture map projection:     latlon

#Soil parameters:
Soils map projection:          latlon
Soils spatial transform:      none 

#Topography maps
Elevation data source:         GTOPO30_Native
Elevation number of bands:      1
Elevation map:                 input/LS_PARAMETERS/topo_parms/GTOPO30/raw_updated
Elevation fill option:          neighbor
Elevation fill radius:          3
Elevation fill value:           287
Topography spatial transform:   average
Topography map projection:      latlon

# =======================================================
### Crop information (used also in conjuction with irrigation modeling)
Incorporate crop information:       .true.             # .true. = incorporate crop/irrig info with LSM parameters

Crop classification:         "MIRCA"    # none | CROPMAP | FAOSTAT01 | FAOSTAT05 | MIRCA | MIRCA52
Crop library directory:      "input/Crop.Library.Files/"

# Crop maps:
Crop type data source:       "MIRCA"    # UMDCROPMAP | Monfreda08 | CONSTANT | MIRCA
Crop type file:              "input/MIRCA2000/monthly_growing_area_grids/crop_"
Crop map spatial transform:  "average"  # Upscale 

Assign crop value type:      "none"     # "none", assign crop type data | "single", assign  "Default crop type" value for "CONSTANT" 
Default crop type:           "wheat"    # "maize", "millet", etc.

#Irrigation fraction maps
Irrigation fraction data source:  "GIA" # MODIS_OG | GRIPC | UserDerived | GIA
Irrigation fraction map:          input/global_irrigated_areas/global_irrigated_areas.tif 
Irrigation fraction spatial transform: average      # none | average | neighbor
Irrigation fraction type option:  "sprinkler+paddy" # sprinkler | paddy | sprinkler+paddy

#Irrigation type maps
Irrigation type data source:          "AQUASTAT"  # AQUASTAT | GRIPC
Irrigation type map:         "input/irrig_params/"  
Irrigation type spatial transform:     "mode"     # none | neighbor | mode
Assign irrigation type:      "sprinkler" # sprinkler | drip | sprinkler+drip
                                         # applied if GRIPC is type data source
Assign sprinkler fraction:    0.5        # fraction of sprinkler+drip

# Merge irrigation fraction and type data with another dataset
# eg. merge GIA fraction with GRIPC type and MIRCA crops
Merge crop and irrigation information:  .true.
Crop irrigation merge data source:  "GRIPC" # default "none" if Merge crop is false
Crop irrigation merge data map:   input/irrig_params/irrigtype_salmon2013_gia_ricemask.flt
Crop irrigation merge data spatial transform:    tile

# Crop planting/harvesting dates if applicable:
Crop Calendar information:     .true.   
Crop Calendar data source:     "MIRCA"   # none | MIRCA
Crop Calendar data map:        "none"    # the same as crop type file for MIRCA
Crop Calendar data spatial transform:  "average"  # the same as crop map
Multiple Cropping Max Seasons:   2       # only 2 for now
 

