# =============================================================================
# WSF OPL Configuration Section
# =============================================================================
WSF valid date (YYYYMMDDHH):            2025060100
# WSF input data directory (where raw WSF NetCDF files are located)
WSF input directory:                    /discover/nobackup/projects/usaf_lis/MET_FORCING/WSF/202506
WSF filelist suffix number:             1
# WSF output directory (where resampled files will be written)
WSF output directory:                   /discover/nobackup/projects/usaf_lis/ejalilvand/data/WSF_TB_resampled_hourly
WSF filter snow and precip footprints:  0 # Make sure this is 0.

# Values:
#   1  = Filter ON  (default) — Footprints with snow or precip flags are
#        excluded from TB accumulation during resampling. Use this for
#        soil moisture retrieval.
#        Output: WSF_SDR_resampled_YYYYMMDD_tHH00_ASC.nc  (unchanged)
#
#   0  = Filter OFF — All footprints are kept, including those with snow
#        or precip flags. Snow/precip flags are still detected and recorded
#        in the quality flag (bits 1 and 2) for downstream use.
#        Use this for snow depth retrieval.
#        Output: WSF_SDR_resampled_allfp_YYYYMMDD_tHH00_ASC.nc
#
# If this line is omitted from ldt.config, the default behavior is 1
# (filter ON), preserving backward compatibility.
